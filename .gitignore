# ── Python 编译产物 ──────────────────────────────
__pycache__/
*.py[cod]
.venv/
runtime/tmp/

# ── 日志/状态备份 ────────────────────────────────
*.bak

# ── 运行时状态与日志（非源码、日抛，不入库）────────────
# state/*.json 是运行时判据数据（publish_log / update_state / applied /
# pending_pool / abandoned / inflight / risk_state），每次运行都会变、
# 持续脏化工作区；跨机器同步反而会把本机的瞬时状态带过去。
# 版本快照由 tools/backup_snapshots.py 承担，state 不入库。
**/state/*
!**/state/README.md
!**/state/.gitkeep

# ── core-overrides apply 前备份（2026-10-07 移到技能树外）──────
# 现在落在 ~/WorkBuddy/ai-xhs/_skill-backup/core-overrides-preapply/。
# 为什么必须移出 skills/ 树：WorkBuddy 递归扫描 skills/**/SKILL.md 并按
# frontmatter 的 name 注册技能，备份里的 SKILL.md 与本体同名 → 列表出现多条
# 同名 red-book-skills，且备份是旧版，同名时加载到哪份不确定、有回退风险。
# 仓库内已不再生成该目录；此规则仅为历史遗留兜底。
core-overrides/state/backup/

# 各 patch 的 logs/ 运行时日志，同理不入库。
**/logs/*
*.log
!**/logs/README.md
!**/logs/.gitkeep

# ── 登录态与凭据（绝不入库）──────────────────────
# 浏览器导出的 cookie、账号配置、会话缓存和认证响应均属本机私有数据。
*.cookie
*.cookies
cookies.json
accounts.json
credentials.json
auth.json
session.json
session/
sessions/
auth/
credentials/
profiles/
browser-profile/
chrome-profile/

# ── 手工备份快照（_archive/bak_*）──────────────────
# 只留最近 3 轮在工作区，更早的交给 git 历史（见 DOC_LAYOUT.md「定期整理机制」）。
_archive/

# ── 上游只读备份（不作为 Patch、不参与公开同步）────────
# red-book-skills-upstream 仅用于本地对照和兼容检查；运行时加载只认上游安装目录
# 与本目录下的 Patch，避免把整份上游再次复制进 Patch 仓库。
red-book-skills-upstream/

# ── 编辑器 / 系统 ────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
